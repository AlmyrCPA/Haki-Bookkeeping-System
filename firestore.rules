rules_version = '2';

// Phase 1: one shared login, no role granularity yet. Any signed-in user can
// read and write every client's books. Phase 2 tightens this per the migration
// brief (membership claims per clientId).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
