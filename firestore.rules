rules_version = '2';

// Phase 1: one shared login, no role granularity yet. Access is restricted to
// a fixed allowlist of team emails until Phase 2 introduces per-clientId
// membership claims per the migration brief.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowedUser() {
      return request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email in [
          'myclients.bir2018@gmail.com'
        ];
    }

    match /{document=**} {
      allow read, write: if isAllowedUser();
    }
  }
}
