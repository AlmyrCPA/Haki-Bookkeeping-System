# Optional. The app ships with the production Firebase config baked in
# (see src/firebase.js), so you only need this file to point a local or
# preview build at a DIFFERENT Firebase project. Copy to `.env` and fill in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
